# SyHost - Git'e eklenmeyecek dosyalar

# Kullanici verileri: ayarlar, sunucu listesi, playit gizli anahtari, kayitlar
# Bunlar asla commit'lenmemeli. playit.toml gizli anahtar icerir.
ayarlar.json
sunucular.json
pencere.json
*.toml
*.log
cache/

# Tasinabilir surum repo icinde denenirse olusan klasorler
/App/
/Data/
/Servers/

# .NET derleme ciktilari (ana surum)
bin/
obj/
dist/
publish/
artifacts/
TestResults/
*.exe
*.dll
*.pdb
*.user
*.suo
.vs/

# Editorler ve Windows
.vscode/
.idea/
Thumbs.db
desktop.ini

# Claude Code calisma kopyalari ve yerel ayarlari
.claude/
